# Production settings for the Django API (set these in the Render dashboard).
# Leave all of them unset for local development: you get DEBUG on and SQLite.

DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Aiven for PostgreSQL -> Overview -> Service URI
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require
# Extra hostnames, comma separated (Render's own *.onrender.com host is added automatically)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
